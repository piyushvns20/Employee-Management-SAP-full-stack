{
  "name": "EmployeeManagement",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "hybrid": "cds watch --profile hybrid",
    "deploy:hana": "cds deploy --to hana:EmployeeManagement-db",
    "watch-employeemgntui": "cds watch --open employeemgntui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy EmployeeManagement --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "db": "hana",
      "html5-repo": true,
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin",
                "Viewer"
              ]
            },
            "viewer": {
              "password": "viewer",
              "roles": [
                "Viewer"
              ]
            }
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
